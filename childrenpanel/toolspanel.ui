<ui version="4.0">
 <class>ToolsPanel</class>
 <!-- The panel has no designable children: the built-in tools are custom
      painted chips laid out in C++, and the script tools are created from
      whatever extra_tools.py declares. The width is the icon rail's own
      width (8 padding + 44 + 6 + 44 + 8) so Designer shows the real size. -->
 <widget class="QWidget" name="ToolsPanel">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>126</width>
    <height>230</height>
   </rect>
  </property>
 </widget>
