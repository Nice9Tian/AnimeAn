{
  "type": "ScrollBar",
  "label": "滚动条",
  "description": "水平或垂直滚动条，支持范围、步长和双向绑定数字状态",
  "defaultSize": { "width": 160, "height": 16 },
  "entry": "index.js",
  "style": "style.css",
  "props": {
    "min":         { "type": "number",  "default": 0 },
    "max":         { "type": "number",  "default": 100 },
    "step":        { "type": "number",  "default": 1 },
    "pageStep":    { "type": "number",  "default": 10 },
    "orientation": { "type": "string",  "default": "horizontal" },
    "value":       { "type": "number",  "default": 0, "logic": true },
    "enabled":     { "type": "boolean", "default": true, "logic": true }
  },
  "bind": "number",
  "events": ["change"],
  "children": false,
  "qt": {
    "widget": "QScrollBar",
    "props": {
      "min": "minimum",
      "max": "maximum",
      "step": "singleStep",
      "pageStep": "pageStep",
      "orientation": "vfOrientation",
      "value": "value"
    },
    "events": {
      "change": { "signal": "valueChanged", "type": "number" }
    }
  }
}
