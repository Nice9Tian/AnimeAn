{
  "type": "QtTabBar",
  "label": "Qt 页签栏",
  "description": "和 Qt 版一样的页签，tabs 和 widths 都用逗号分隔，widths 是每个页签的宽度",
  "defaultSize": {
    "width": 144,
    "height": 23
  },
  "entry": "index.js",
  "style": "style.css",
  "props": {
    "tabs": { "type": "string", "default": "Tab 1,Tab 2", "logic": true },
    "widths": { "type": "string", "default": "66,66" },
    "value": { "type": "number", "default": 0, "logic": true }
  },
  "bind": "number",
  "events": ["change"],
  "children": false
}
