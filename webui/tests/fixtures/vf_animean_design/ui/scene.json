{
  "version": 1,
  "root": "window",
  "windows": [
    "window",
    "newProjectDialog",
    "drawSettingsDialog",
    "textureFloatDialog"
  ],
  "nodes": {
    "window": {
      "type": "Window",
      "width": 1280,
      "height": 800,
      "title": "AnimeAn 动画工作台",
      "menuBar": {
        "height": 28,
        "menus": [
          {
            "id": "fileMenu",
            "title": "文件",
            "items": [
              {
                "id": "menuNewProject",
                "text": "新建项目...",
                "shortcut": "Ctrl+N",
                "emit": "openNewProject"
              },
              {
                "id": "menuOpenProject",
                "text": "打开项目...",
                "shortcut": "Ctrl+O",
                "emit": "openProjectFile"
              },
              {
                "id": "menuSaveProject",
                "text": "保存项目",
                "shortcut": "Ctrl+S",
                "emit": "saveProjectFile"
              },
              {
                "id": "menuSaveAsProject",
                "text": "另存为...",
                "shortcut": "Ctrl+Shift+S",
                "emit": "saveAsProjectFile"
              },
              {
                "id": "menuTextureSub",
                "text": "纹理文件 (Texture)",
                "items": [
                  {
                    "id": "menuOpenTexture",
                    "text": "打开纹理视图 (.textureview)...",
                    "emit": "openTextureFile"
                  },
                  {
                    "id": "menuSaveTexture",
                    "text": "保存纹理视图 (.textureview)",
                    "emit": "saveTextureFile"
                  }
                ]
              },
              {
                "id": "menuExportSub",
                "text": "导入与导出",
                "items": [
                  {
                    "id": "menuImportImage",
                    "text": "导入图像素材...",
                    "shortcut": "Ctrl+I",
                    "emit": "importImageAsset"
                  },
                  {
                    "id": "menuExportClip",
                    "text": "导出视频片段...",
                    "shortcut": "Ctrl+E",
                    "emit": "triggerExportClip"
                  }
                ]
              }
            ]
          },
          {
            "id": "viewMenu",
            "title": "视图",
            "items": [
              {
                "id": "menuToggleTools",
                "text": "工具栏",
                "dock": "toolsDock",
                "checkable": true,
                "checked": true
              },
              {
                "id": "menuToggleLayers",
                "text": "图层与素材面板",
                "dock": "layersDock",
                "checkable": true,
                "checked": true
              },
              {
                "id": "menuToggleInspector",
                "text": "选项与检查器面板",
                "dock": "inspectorDock",
                "checkable": true,
                "checked": true
              },
              {
                "id": "menuToggleTimeline",
                "text": "时间轴面板",
                "dock": "timelineDock",
                "checkable": true,
                "checked": true
              },
              {
                "id": "menuOnionSkinToggle",
                "text": "洋葱皮透视",
                "shortcut": "O",
                "checkable": true,
                "checked": false,
                "emit": "toggleOnionSkin"
              },
              {
                "id": "menuToggleTextureFloat",
                "text": "浮动纹理子视图 (FloatBox)",
                "shortcut": "Ctrl+T",
                "emit": "toggleTextureFloatWindow"
              },
              {
                "id": "menuEmbedTexture",
                "text": "嵌入纹理至工具面板",
                "emit": "embedTextureInToolOptions"
              },
              {
                "id": "menuResetLayout",
                "text": "重置工作区布局",
                "emit": "resetWorkspaceLayout"
              }
            ]
          },
          {
            "id": "editMenu",
            "title": "编辑",
            "items": [
              {
                "id": "menuUndo",
                "text": "撤销",
                "shortcut": "Ctrl+Z",
                "emit": "undoHistory"
              },
              {
                "id": "menuRedo",
                "text": "重做",
                "shortcut": "Ctrl+Y",
                "emit": "redoHistory"
              },
              {
                "id": "menuClearFrame",
                "text": "清空当前帧",
                "shortcut": "Del",
                "emit": "clearCurrentFrame"
              }
            ]
          },
          {
            "id": "autoMappingMenu",
            "title": "自动映射",
            "items": [
              {
                "id": "menuAutoColorize",
                "text": "一键自动上色",
                "shortcut": "Alt+C",
                "emit": "runAutoColorize"
              },
              {
                "id": "menuAutoInbetween",
                "text": "生成中间帧补间",
                "shortcut": "Alt+I",
                "emit": "runAutoInbetween"
              },
              {
                "id": "menuTextureSync",
                "text": "同步纹理映射",
                "emit": "syncTextureMapping"
              }
            ]
          },
          {
            "id": "drawMenu",
            "title": "绘图设置",
            "items": [
              {
                "id": "menuDrawSettings",
                "text": "画笔与压感设置...",
                "shortcut": "F5",
                "emit": "openDrawSettings"
              },
              {
                "id": "menuStabilizerSub",
                "text": "抖动修正等级",
                "items": [
                  {
                    "id": "menuStabOff",
                    "text": "关闭修正 (S0)",
                    "kind": "radio",
                    "group": "stabilizerGroup",
                    "checked": false,
                    "emit": "setStabilizerOff"
                  },
                  {
                    "id": "menuStabMed",
                    "text": "标准修正 (S5)",
                    "kind": "radio",
                    "group": "stabilizerGroup",
                    "checked": true,
                    "emit": "setStabilizerMed"
                  },
                  {
                    "id": "menuStabHigh",
                    "text": "强力平滑 (S12)",
                    "kind": "radio",
                    "group": "stabilizerGroup",
                    "checked": false,
                    "emit": "setStabilizerHigh"
                  }
                ]
              }
            ]
          },
          {
            "id": "themeMenu",
            "title": "主题",
            "items": [
              {
                "id": "menuThemeDark",
                "text": "深色创作主题",
                "kind": "radio",
                "group": "themeGroup",
                "checked": true,
                "emit": "setThemeDark"
              },
              {
                "id": "menuThemeGraphite",
                "text": "石墨灰护眼主题",
                "kind": "radio",
                "group": "themeGroup",
                "checked": false,
                "emit": "setThemeGraphite"
              },
              {
                "id": "menuThemeLight",
                "text": "明亮浅色主题",
                "kind": "radio",
                "group": "themeGroup",
                "checked": false,
                "emit": "setThemeLight"
              }
            ]
          }
        ]
      },
      "statusBar": "statusBar",
      "central": "centralArea",
      "docks": [
        "toolsDock",
        "timelineDock",
        "layersDock",
        "inspectorDock"
      ],
      "dockLayout": {
        "areas": {
          "top": {
            "size": 62,
            "groups": [
              {
                "tabs": [
                  "toolsDock"
                ],
                "active": "toolsDock"
              }
            ]
          },
          "bottom": {
            "size": 162,
            "groups": [
              {
                "tabs": [
                  "timelineDock"
                ],
                "active": "timelineDock"
              }
            ]
          },
          "left": {
            "size": 236,
            "groups": [
              {
                "tabs": [
                  "layersDock"
                ],
                "active": "layersDock"
              }
            ]
          },
          "right": {
            "size": 264,
            "groups": [
              {
                "tabs": [
                  "inspectorDock"
                ],
                "active": "inspectorDock"
              }
            ]
          }
        },
        "floating": []
      },
      "children": [
        "toolsDock",
        "layersDock",
        "centralArea",
        "inspectorDock",
        "timelineDock",
        "statusBar"
      ]
    },
    "toolsDock": {
